{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Peregrine",
  "scopeName": "source.peregrine",
  "fileTypes": ["pgr"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#function-call" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.peregrine",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.peregrine",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.peregrine",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.peregrine",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.peregrine",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.peregrine",
          "match": "\\b(if|else|return)\\b"
        },
        {
          "name": "keyword.other.peregrine",
          "match": "\\b(let|fn)\\b"
        },
        {
          "name": "constant.language.boolean.peregrine",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.peregrine",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.peregrine",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.peregrine",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.peregrine",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.assignment.peregrine",
          "match": "="
        },
        {
          "name": "punctuation.definition.lambda.peregrine",
          "match": "\\|"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.peregrine",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.peregrine",
          "match": ":"
        },
        {
          "name": "punctuation.terminator.statement.peregrine",
          "match": ";"
        },
        {
          "name": "punctuation.section.braces.peregrine",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.parens.peregrine",
          "match": "[()]"
        },
        {
          "name": "punctuation.section.brackets.peregrine",
          "match": "[\\[\\]]"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.peregrine"
        },
        {
          "match": "\\bfn\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.declaration.peregrine" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.peregrine",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
